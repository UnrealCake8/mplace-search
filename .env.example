# Firebase web app (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only; never prefix these with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production only: lets one secure MPlace session work across mplace.cc subdomains.
# Leave unset for localhost development.
MPLACE_COOKIE_DOMAIN=.mplace.cc

# Protects /api/crawl/run. Set this to a long random value in production.
# Vercel Cron automatically sends CRON_SECRET as a Bearer token when configured.
CRAWLER_SECRET=
CRON_SECRET=

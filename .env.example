# Shared MPlace ID Firebase web app (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDAoKipu6_NqS9H7HdfAXBK_t8thjJhaPA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mplace-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mplace-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mplace-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1057556755250
NEXT_PUBLIC_FIREBASE_APP_ID=1:1057556755250:web:aa5ce5e9c4ba4d83b61d2b

# Firebase Admin SDK for the same mplace-id project.
# Set these in Vercel/server env; never expose them with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=mplace-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production only: lets one secure MPlace session work across mplace.cc subdomains.
# Leave unset for localhost development.
MPLACE_COOKIE_DOMAIN=.mplace.cc

# Protects /api/crawl/run. Set this to a long random value in production.
CRAWLER_SECRET=
CRON_SECRET=
